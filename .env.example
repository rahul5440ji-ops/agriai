# AgriAI Environment Variables
# Copy to .env for local development

# Database
DATABASE_URL=sqlite:///./agriai.db

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# ML Models
ML_MODELS_PATH=./models
MODEL_YIELD_PATH=./models/yield_model.pkl
MODEL_PRICE_PATH=./models/price_model.pkl

# Data Sources (API Keys if needed)
DATA_GOV_IN_TOKEN=your_token_here
AGMARKNET_TOKEN=your_token_here
WEATHER_API_KEY=your_token_here

# Security
SECRET_KEY=your_secret_key_here

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_PRICE_FORECAST=true
ENABLE_ADVANCED_ANALYTICS=true